# Visual Crossing Weather API key — https://www.visualcrossing.com/sign-up
# Server-side only: read in app/api/weather/route.ts, never exposed to the client.
VISUAL_CROSSING_API_KEY=

# Set to 1 during UI work to serve generated weather instead of calling the API.
# Each live lookup costs 25 records against a 1000/day free tier; this costs nothing.
# Ignored in production builds. Any value other than exactly "1" leaves it off.
WEATHER_FIXTURE=
